# Environment for the web-port control plane (Docker-free, child-process launcher).
# Copy to /etc/triplea-web/control-plane.env and fill in the secrets. Referenced by the systemd unit.
# The control plane reads ONLY environment variables (no config files); it fails fast if a required
# one is missing or invalid.

# --- Database (a local Postgres; the control plane runs Flyway migrations on boot) ---
CONTROL_PLANE_DB_URL=jdbc:postgresql://localhost:5432/triplea_web
CONTROL_PLANE_DB_USER=triplea_web
CONTROL_PLANE_DB_PASSWORD=CHANGE_ME_db_password

# --- Session / access ---
# >= 32 chars. Generate: openssl rand -base64 48
CONTROL_PLANE_JWT_SECRET=CHANGE_ME_a_long_random_secret_at_least_32_chars
# Comma-separated invited identities. With dev-login, entries are provider:subject where subject is
# the name each player logs in with (e.g. google:alice). With real Google OAuth, invite by email —
# google:alice@example.com — since the provider subject is opaque and unknown before first login
# (a provider:subject entry also works once you know the subject; a rejected login logs it).
CONTROL_PLANE_ALLOWLIST=google:alice@example.com,google:bob@example.com

# --- Login ---
# profile=dev keeps dev-login available; profile=prod forbids dev-login and REQUIRES Google OAuth
# (and marks cookies Secure). Caddy serves only HTTPS either way.
CONTROL_PLANE_PROFILE=dev
CONTROL_PLANE_DEV_LOGIN=true

# --- Google OAuth (required in prod; optional in dev alongside dev-login) ---
# Create an OAuth 2.0 "Web application" client in Google Cloud Console. Authorized redirect URI:
#   https://<your-domain>/api/oauth/google/callback   (must match CONTROL_PLANE_PUBLIC_URL below)
# Leave blank to disable Google login. When set, CONTROL_PLANE_PUBLIC_URL must be set too.
CONTROL_PLANE_OAUTH_GOOGLE_CLIENT_ID=
CONTROL_PLANE_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Game spawning (Docker-free) ---
CONTROL_PLANE_LAUNCHER=process
# Absolute path to the installed game-web-server launcher (from :game-web-server:installDist).
CONTROL_PLANE_GAME_BIN=/opt/triplea-web/game-app/game-web-server/build/install/game-web-server/bin/game-web-server
# Max heap per game JVM — the key resource cap (an uncapped JVM defaults to ~25% of host RAM).
CONTROL_PLANE_GAME_HEAP=-Xmx512m
# Shared token the game processes present to the internal reporting endpoint. Any long random string.
CONTROL_PLANE_GAME_TOKEN=CHANGE_ME_game_token
# Reap an idle game (no committed turn, no connected player) after this many seconds.
CONTROL_PLANE_GAME_IDLE_SECONDS=1800

# --- The map this lobby can host (absolute path to the game XML on the box) ---
CONTROL_PLANE_GAME_XML=/opt/triplea-web/maps/world_war_ii_pacific-master/map/games/ww2pac40_2nd_edition.xml

# --- Public URL (for OAuth callbacks / absolute links; optional now) ---
CONTROL_PLANE_PUBLIC_URL=https://triplea.example.com

# --- "Your turn" Web Push (optional; leave blank to disable push entirely) ---
# Generate the key pair once: ./gradlew :game-control-plane:generateVapidKeys -q
# Both keys must be set together, and the subject is required when keys are set (a mailto: or
# https: URL identifying the sender to the push services). Keep the private key secret.
CONTROL_PLANE_VAPID_PUBLIC_KEY=
CONTROL_PLANE_VAPID_PRIVATE_KEY=
CONTROL_PLANE_VAPID_SUBJECT=mailto:you@example.com

# --- HTTP port the control plane binds locally (Caddy proxies to this) ---
CONTROL_PLANE_HTTP_PORT=7000
